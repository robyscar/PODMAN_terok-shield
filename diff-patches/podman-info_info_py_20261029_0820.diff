@@ -34,6 +35,13 @@ class PodmanInfo:
         Uses ``rootlessNetworkCmd`` when available (podman 5+).
         When absent (podman 4.x), defaults to slirp4netns if its
         executable is available — podman 4.x defaults to slirp4netns.
+
+        Rootful engines always use the default bridge network, so
+        ``rootless=False`` short-circuits to ``"bridge"`` regardless of
+        ``rootlessNetworkCmd`` (which podman still reports on rootful
+        hosts even though it is unused there).
         """
+        if not self.rootless:
+            return "bridge"
         if self.rootless_network_cmd in ("pasta", "slirp4netns"):
             return self.rootless_network_cmd
         # Field absent → podman 4.x → default is slirp4netns
@@ -68,10 +76,12 @@ def parse_podman_info(json_str: str) -> PodmanInfo:
